{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Bench",
  "version": "1.0.0",
  "identifier": "com.wolinski.tauri-bench",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "IPC bench", "width": 1000, "height": 700 }],
    "security": { "csp": null, "capabilities": ["default"] }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
